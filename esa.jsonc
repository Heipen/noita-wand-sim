// 阿里云 ESA「函数和 Pages」配置（通过导入 GitHub 仓库构建时读取）。
// 站点是纯静态 Vite 应用：安装 → 构建 → 托管 dist/，没有边缘函数。
// 注意：这里用 build:pages 把资源前缀固定成 /noita-wand-sim/，ESA 必须通过
// 「域名 + /noita-wand-sim」的子路径访问（或绑定根域名时加一条路径规则改写到这个前缀），
// 否则页面会 404。若要让 ESA 直接挂根域名，把 buildCommand 换成 "npm run build"。
{
  "name": "noita-wand-sim",
  "description": "Noita wand simulator (static Vite + React app)",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:pages",
  "assets": {
    "directory": "./dist",
    "notFoundStrategy": "singlePageApplication"
  },
  "dev": {
    "port": 18080
  }
}
