// 阿里云 ESA「函数和 Pages」配置（通过导入 GitHub 仓库构建时读取）。
// 站点是纯静态 Vite 应用：安装 → 构建 → 托管 dist/，没有边缘函数。
// 注意：Vite 构建产物使用以 / 开头的绝对路径，因此必须托管在域名根路径，
// 绑定自定义域名时请用根域名（如 wands.example.com），不要用子路径。
{
  "name": "noita-wand-sim",
  "description": "Noita wand simulator (static Vite + React app)",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "assets": {
    "directory": "./dist",
    "notFoundStrategy": "singlePageApplication"
  },
  "dev": {
    "port": 18080
  }
}
